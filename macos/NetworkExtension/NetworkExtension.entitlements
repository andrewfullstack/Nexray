<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required to register a packet-tunnel Network Extension. Apple must
         approve this entitlement explicitly per
         https://developer.apple.com/contact/request/networkextension-entitlement -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>

    <!-- The extension still runs sandboxed. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound + inbound traffic for xray-core's connections. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Group container shared with the host app for IPC + config files. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.dev.nexray.app</string>
    </array>
</dict>
</plist>
