<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Host-side entitlements: the Tauri app must hold the same
         packet-tunnel-provider entitlement to install + start the extension
         via NETunnelProviderManager. -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>

    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Shared container for host ↔ extension IPC + config snapshots. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.dev.nexray.app</string>
    </array>
</dict>
</plist>
